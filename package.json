{
  "name": "reversi",
  "version": "1.16.0",
  "private": true,
  "scripts": {
    "clean": "find src -name '*.js' -delete",
    "predev": "npm run clean",
    "dev": "vite",
    "prebuild": "npm run clean",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test:unit": "vitest",
    "test:integration": "vitest --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "knip": "knip",
    "prepare": "npx simple-git-hooks || true"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "commit-msg": "npx --no -- commitlint --edit $1",
    "pre-push": "./node_modules/.bin/playwright install chromium --with-deps && ./node_modules/.bin/playwright test"
  },
  "lint-staged": {
    "*.{vue,ts}": [
      "eslint --fix",
      "git add"
    ]
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "canvas-confetti": "^1.9.4",
    "pinia": "^3.0.4",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vuetify": "^4.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/canvas-confetti": "^1.9.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^4.1.12",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.8.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-vue": "^10.12.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "knip": "^6.44.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "sass": "^1.107.1",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-vuetify": "^2.0.3",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "js-beautify": "^2.0.3"
  }
}
